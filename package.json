{
  "name": "tuxocr",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "bash scripts/build-worker.sh",
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "prebuild": "bash scripts/build-worker.sh",
    "build": "next build && bash scripts/post-build.sh",
    "build:worker": "bash scripts/build-worker.sh",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log"
  },
  "dependencies": {
    "next": "^16.1.1",
    "onnxruntime-web": "^1.31.1",
    "ppu-paddle-ocr": "^6.7.0",
    "ppu-pdf": "^6.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "typescript": "^5"
  }
}
